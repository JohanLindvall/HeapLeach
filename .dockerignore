# Keep the build context small and force a clean frontend build in-image.
.git
.gitignore
# Private live-test symlinks point outside the Docker build context.
**/*live_test.go
bin/
downloads/
node_modules/
frontend/node_modules/
frontend/dist/
backend/internal/webui/dist/
**/*.tsbuildinfo
**/.DS_Store
README.md
docker-compose.yml
Makefile
helpers/captcha/.venv/
helpers/captcha/build/
helpers/captcha/dist/
helpers/captcha/__pycache__/
